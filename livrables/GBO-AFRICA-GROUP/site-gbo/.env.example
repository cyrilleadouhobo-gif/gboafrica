# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Canonical production URL, no trailing slash. Domain decided: gboafrica.com (no accent —
# "gbôafrica.com" would need IDN/punycode encoding, poorly supported by some clients, and
# the codebase already uses the unaccented form for e-mail addresses).
# Used to build sitemap.xml, robots.txt and Open Graph tags. Falls back to
# http://localhost:5300 in dev — see lib/site.js. Set this once the domain is registered.
SITE_URL="https://www.gboafrica.com"

# Used only by the Prisma CLI (db push/migrate/studio), which requires a literal "file:"
# path. Leave as-is — it's never read at runtime.
DATABASE_URL="file:./dev.db"

# Turso (hosted SQLite/libSQL) — the real database, used for both local dev and production
# so behavior stays identical between the two. Create a free database at https://turso.tech,
# then get this full connection string (with the auth token embedded) from the dashboard,
# combined as: libsql://<db-name>-<org>.turso.io?authToken=<token>
# After any prisma/schema.prisma change: npm run db:push && node scripts/push-schema-to-turso.mjs
TURSO_DATABASE_URL=""

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# First back-office account, created by `npm run db:seed`. Password must be 12+ characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Le Centre Médico Nutrition's single shared partner account (role: nutrition_partner),
# created by `npm run db:seed`. Scoped to /partenaires/nutrition + /api/partner/* only —
# see lib/auth.js getCurrentNutritionPartner(). Password must be 12+ characters.
NUTRITION_PARTNER_EMAIL=""
NUTRITION_PARTNER_PASSWORD=""

# Transactional email (optional). Get a free key at https://resend.com.
# Without it, confirmation e-mails are logged server-side instead of sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# Destination of every form notification (contact, partenariats, candidatures, salles
# partenaires) — see lib/site.js CONTACT_EMAIL. Falls back to contact@gboafrica.com if unset.
CONTACT_EMAIL=""

# WhatsApp Business Platform (optional — see lib/whatsapp.js). Requires a verified Meta
# Business, a WhatsApp Business Platform app with a registered phone number, and the
# "lead_confirmation" + "company_confirmation" templates approved (see README.md for the
# exact copy to submit). WHATSAPP_PHONE_NUMBER_ID is the Meta phone number ID, NOT the
# phone number itself — find it in Meta for Developers > WhatsApp > API Setup.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
