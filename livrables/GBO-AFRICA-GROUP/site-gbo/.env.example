# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Canonical production URL, no trailing slash (e.g. "https://www.gboafricagroup.com").
# Used to build sitemap.xml, robots.txt and Open Graph tags. Falls back to
# http://localhost:5300 in dev — see lib/site.js. Set this once the domain is chosen.
SITE_URL=""

# For local dev, SQLite is fine: DATABASE_URL="file:./dev.db"
# For a real deployment (e.g. Vercel), provision a hosted Postgres (Neon, Supabase...),
# switch `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma,
# then run `npx prisma migrate deploy`.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# First back-office account, created by `npm run db:seed`. Password must be 12+ characters.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Transactional email (optional). Get a free key at https://resend.com.
# Without it, confirmation e-mails are logged server-side instead of sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# WhatsApp Business Platform (optional, not implemented yet — see lib/whatsapp.js).
# Requires a Meta Business verification and approved message templates.
WHATSAPP_TOKEN=""
